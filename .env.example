# WoundWatch environment. Copy to `.env` and fill in real values.
# `.env` is gitignored; this file documents the variables.

# --- Service ---
ENV=development
APP_NAME=woundwatch

# --- Datastores ---
# WoundWatch owns a `woundwatch` schema on the EXISTING Aidbox FHIR Postgres
# instance (a staging area, not the FHIR source of truth). currentSchema keeps
# WoundWatch tables isolated from the FHIR canonical store.
DATABASE_URL=postgresql://woundwatch:CHANGE_ME@postgres.cathousedev.com:5432/homelab?currentSchema=woundwatch

# --- FHIR server (Aidbox; existing deployment) ---
# Postgres-backed. WoundWatch's staging DB (DATABASE_URL) shares this host.
# Auth is a single Bearer API-key/JWT (not HAPI basic-auth).
FHIR_BASE_URL=http://aidbox.cathousedev.com:27017/api
FHIR_API_KEY=

# --- MedGemma (local inference endpoint; Phase 4) ---
MEDGEMMA_ENDPOINT=http://medgemma:8001/v1
MEDGEMMA_MODEL_NAME=medgemma
MEDGEMMA_TIMEOUT_S=30

# Which VisionModelAdapter the pipeline uses: mock | medgemma
VISION_ADAPTER=mock

# --- Storage ---
IMAGE_STORAGE_PATH=/data/woundwatch/images

# --- Auth (write endpoints; Phase 9) ---
API_KEY=
