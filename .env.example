# WoundWatch environment. Copy to `.env` and fill in real values.
# `.env` is gitignored; this file documents the variables.

# --- Service ---
ENV=development
APP_NAME=woundwatch

# --- Datastores ---
# WoundWatch's OWN Postgres (its own container — fully independent of the FHIR
# server, so WoundWatch stands on its own). A staging area, not the FHIR source
# of truth. In the compose stack the woundwatch service overrides this to point
# at the `db` container; for local dev point at localhost:5432.
DATABASE_URL=postgresql://woundwatch:CHANGE_ME@localhost:5432/woundwatch

# --- FHIR server (Aidbox today; pluggable, external dependency) ---
# Postgres-backed. WoundWatch's own DB (DATABASE_URL) does NOT share this host.
# Auth is a single Bearer API-key/JWT (not HAPI basic-auth).
FHIR_BASE_URL=http://aidbox.cathousedev.com:27017/api
FHIR_API_KEY=

# --- MedGemma (local inference endpoint; Phase 4) ---
MEDGEMMA_ENDPOINT=http://medgemma:8001/v1
MEDGEMMA_MODEL_NAME=medgemma
MEDGEMMA_TIMEOUT_S=30

# Which VisionModelAdapter the pipeline uses: mock | medgemma
VISION_ADAPTER=mock

# --- Storage ---
IMAGE_STORAGE_PATH=/data/woundwatch/images

# --- Auth (write endpoints; Phase 9) ---
API_KEY=
